{
  "name": "stream-scrobbler",
  "main": "index.mjs",
  "compatibility_date": "2026-08-06",
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": false },
  "d1_databases": [
    { "binding": "DB", "database_name": "stream-scrobbler", "database_id": "REPLACE_WITH_D1_DATABASE_ID" }
  ],
  "ratelimits": [
    { "name": "AUTH_LIMIT", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "USER_LIMIT", "namespace_id": "1002", "simple": { "limit": 40, "period": 60 } }
  ],
  "secrets": { "required": ["LASTFM_API_KEY", "LASTFM_SHARED_SECRET", "SESSION_ENCRYPTION_KEY"] }
}
